```gitignore
# ------------------------------------------------------------
# OS / general
# ------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

*.bak
*.tmp
*.temp
*~
*.stackdump


# ------------------------------------------------------------
# Editors
# ------------------------------------------------------------

# Vim
*.swp
*.swo
*.swn
.vim/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Notepad++
*.bak


# ------------------------------------------------------------
# C / C++
# ------------------------------------------------------------

# Dependency files
*.d

# Object files
*.o
*.obj
*.lo
*.slo

# Precompiled headers
*.gch
*.pch

# Libraries
*.a
*.lib
*.la
*.lai

# Shared / dynamic libraries
*.so
*.dylib
*.dll

# Executables
*.exe
*.out
*.app

# Common build directories
build/
bin/
obj/
Debug/
Release/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Compiler output sometimes used in examples
compiled


# ------------------------------------------------------------
# Java
# ------------------------------------------------------------

*.class
*.jar
*.war
*.ear

# Common Java build directories
target/
.gradle/
build/

# IntelliJ / Eclipse, in case they appear
.idea/
*.iml
.classpath
.project
.settings/


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# Local Python version file
.python-version


# ------------------------------------------------------------
# Jupyter notebooks
# ------------------------------------------------------------

.ipynb_checkpoints/


# ------------------------------------------------------------
# Scheme / Racket / DrRacket
# ------------------------------------------------------------

# DrRacket autosave / backup files
*.rkt~
*.scm~
*.ss~
*.1
*.2

# Racket compiled files
compiled/


# ------------------------------------------------------------
# Prolog
# ------------------------------------------------------------

# SWI-Prolog quick load / saved states
*.qlf
*.sav


# ------------------------------------------------------------
# Databases / course-specific files
# ------------------------------------------------------------

*.mdb
lock.mdb
data.mdb
lock


# ------------------------------------------------------------
# Course-specific generated files
# ------------------------------------------------------------

c/c5/example
```
